# NAPI Desktop — build-time config template.
# Copy to .env and fill in. `.env` is gitignored; this file is committed.
#
#   cp .env.example .env
#
# Only values actually read at build time belong here. The client ID and the
# gateway URL are fetched at runtime (/api/status and app state), so they are
# deliberately absent.

# GitHub OAuth app client secret — https://github.com/settings/developers
# Required for the "Continue with GitHub" sign-in flow. Never commit the real value.
GITHUB_CLIENT_SECRET=replace_with_your_github_oauth_client_secret
